{
  "name": "payload-plugin-encrypted-fields",
  "version": "0.1.0",
  "description": "Payload CMS plugin for encrypted secret fields that hide real values from admin screens and normal API responses.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "encrypted-fields",
    "secrets",
    "cms",
    "sqlite",
    "postgres"
  ],
  "homepage": "https://github.com/ssanaullahrais/payload-plugin-encrypted-fields#readme",
  "bugs": {
    "url": "https://github.com/ssanaullahrais/payload-plugin-encrypted-fields/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssanaullahrais/payload-plugin-encrypted-fields.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js",
      "default": "./dist/mask.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "npm run demo:prepare && npm --prefix examples/payload-sqlite run demo",
    "demo:prepare": "npm pack --pack-destination examples/payload-sqlite && npm --prefix examples/payload-sqlite install ./payload-plugin-encrypted-fields-0.1.0.tgz",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.14",
    "typescript": "^5.7.3"
  }
}
