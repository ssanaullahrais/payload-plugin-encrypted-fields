{
  "name": "payload-plugin-encrypted-fields",
  "version": "0.1.0",
  "description": "Payload CMS field type for storing third-party API credentials encrypted at rest, that never return the real value through any read path (REST/GraphQL/Local API/admin UI) once saved — only a masked placeholder or the decrypted value read back internally by your own server code.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js",
      "default": "./dist/mask.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.14",
    "typescript": "^5.7.3"
  }
}
